asset right.glb
root oculus-touch-right
component xr-standard-trigger xr_standard_trigger
response xr-standard-trigger button transform xr_standard_trigger_pressed_value xr_standard_trigger_pressed_min xr_standard_trigger_pressed_max default,touched,pressed
component xr-standard-squeeze xr_standard_squeeze
response xr-standard-squeeze button transform xr_standard_squeeze_pressed_value xr_standard_squeeze_pressed_min xr_standard_squeeze_pressed_max default,touched,pressed
component xr-standard-thumbstick xr_standard_thumbstick
response xr-standard-thumbstick button transform xr_standard_thumbstick_pressed_value xr_standard_thumbstick_pressed_min xr_standard_thumbstick_pressed_max default,touched,pressed
response xr-standard-thumbstick xAxis transform xr_standard_thumbstick_xaxis_pressed_value xr_standard_thumbstick_xaxis_pressed_min xr_standard_thumbstick_xaxis_pressed_max default,touched,pressed
response xr-standard-thumbstick yAxis transform xr_standard_thumbstick_yaxis_pressed_value xr_standard_thumbstick_yaxis_pressed_min xr_standard_thumbstick_yaxis_pressed_max default,touched,pressed
component a-button a_button
response a-button button transform a_button_pressed_value a_button_pressed_min a_button_pressed_max default,touched,pressed
component b-button b_button
response b-button button transform b_button_pressed_value b_button_pressed_min b_button_pressed_max default,touched,pressed
component thumbrest thumbrest
response thumbrest button transform thumbrest_pressed_value thumbrest_pressed_min thumbrest_pressed_max default,touched,pressed
