asset none.glb
root oculus_go_none
component xr-standard-trigger xr_standard_trigger
response xr-standard-trigger button transform xr_standard_trigger_pressed_value xr_standard_trigger_pressed_min xr_standard_trigger_pressed_max default,touched,pressed
component xr-standard-touchpad xr_standard_touchpad xr_standard_touchpad_axes_touched_value
response xr-standard-touchpad button transform xr_standard_touchpad_pressed_value xr_standard_touchpad_pressed_min xr_standard_touchpad_pressed_max default,touched,pressed
response xr-standard-touchpad xAxis transform xr_standard_touchpad_xaxis_pressed_value xr_standard_touchpad_xaxis_pressed_min xr_standard_touchpad_xaxis_pressed_max default,touched,pressed
response xr-standard-touchpad yAxis transform xr_standard_touchpad_yaxis_pressed_value xr_standard_touchpad_yaxis_pressed_min xr_standard_touchpad_yaxis_pressed_max default,touched,pressed
response xr-standard-touchpad xAxis transform xr_standard_touchpad_xaxis_touched_value xr_standard_touchpad_xaxis_touched_min xr_standard_touchpad_xaxis_touched_max default,touched,pressed
response xr-standard-touchpad yAxis transform xr_standard_touchpad_yaxis_touched_value xr_standard_touchpad_yaxis_touched_min xr_standard_touchpad_yaxis_touched_max default,touched,pressed
response xr-standard-touchpad state visibility xr_standard_touchpad_axes_touched_value - - touched,pressed
